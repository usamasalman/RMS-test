# Database Configuration
POSTGRES_USER=grc_user
POSTGRES_PASSWORD=grc_password_dev
POSTGRES_DB=grc_wisdom
POSTGRES_PORT=5432

# Database URL (for Prisma/TypeORM)
DATABASE_URL=postgresql://grc_user:grc_password_dev@localhost:5432/grc_wisdom

# Application Configuration
NODE_ENV=development
PORT=3001
VITE_HMR_PORT=3002

# Authentication
JWT_SECRET=super_secret_grc_key_for_dev
JWT_EXPIRY=24h

# PgAdmin Configuration
PGADMIN_EMAIL=admin@grc.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Optional: Redis for session/cache (future)
# REDIS_URL=redis://localhost:6379

# Optional: Email Service (future)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-password

